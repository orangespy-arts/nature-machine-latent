NML_PROCESSED_DIR=D:/AudioData/nature-machine-latent/processed
NML_CHECKPOINT_DIR=D:/AudioData/nature-machine-latent/checkpoints
NML_EXPORT_DIR=D:/AudioData/nature-machine-latent/exports
